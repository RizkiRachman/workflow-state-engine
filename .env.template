# Workflow State Engine — Environment Variables
# Copy this to .env and fill in your keys:
#   cp .env.template .env
#
# NOTE: FIRECRAWL_API_KEY, OpenCode API key, and model provider config
# are hardcoded in opencode.json — do not duplicate them here.

# === Graphify (Semantic Extraction & Embeddings) ===
# Required for graphify's LLM-powered semantic extraction (entity/relationship detection).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required for API-based embeddings in graphify (faster than local).
# Also used by the model-fallback plugin.
OPENAI_API_KEY=

# === Model Fallback Plugin ===
# Fallback model keys if the sumopod provider is unavailable.
# Referenced in skills/model-fallback/SKILL.md.
ANTHROPIC_API_KEY=

# === Morph Plugin (Fast Apply + WarpGrep) ===
# Required for @morphllm/opencode-morph-plugin (10,500+ tok/s editing).
# Register at https://morph.so and set in ~/.zshrc:
#   export MORPH_API_KEY='sk-...'
MORPH_API_KEY=
