{
  // Dynamic Context Pruning configuration
  // See https://github.com/Tarquinen/opencode-dynamic-context-pruning for full docs
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
  "enabled": true,
  "compress": {
    "mode": "range",
    "minContextLimit": 40000,
    "maxContextLimit": 500000,
    "protectedTools": [
      "task",
      "skill",
      "todowrite",
      "todoread",
      "gitnexus_context",
      "gitnexus_impact",
      "gitnexus_query",
      "lean-ctx_*"
    ],
    "protectUserMessages": false
  },
  "strategies": {
    "deduplication": {
      "enabled": true
    },
    "purgeErrors": {
      "enabled": true,
      "turns": 4
    }
  },
  "commands": {
    "protectedTools": [
      "task",
      "skill",
      "todowrite",
      "gitnexus_*"
    ]
  },
  "experimental": {
    "customPrompts": false
  }
}
