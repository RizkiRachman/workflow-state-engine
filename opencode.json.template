      "top_p": 1,
      "steps": 30,
      "reasoningEffort": "high",
      "textVerbosity": "low",
      "permission": {
        "task": { "*": "deny" },
        "question": "deny",
        "webfetch": "deny",
        "morph_edit": "deny",
        "gitnexus_rename": "deny",
        "memory_*": "deny",
        "context7_*": "deny",
        "firecrawl_*": "deny"
      },
      "fallback_models": [
        "sumopod/deepseek-v4-flash"
      ]
    }
  },
  "permission": {
    "default": {
      "webfetch": "deny",
      "lean-ctx_*": "allow"
    }
  },
  "mcpServers": {
    // MANDATORY: all agents rely on this — codebase exploration, context, queries
    "context7": {
      "type": "local",
      "cmd": [
        "@upstash/context7-mcp"
      ]
      // OPTIONAL: docs lookup for librarian agent only
    },
    // MANDATORY: all agents rely on this — impact analysis, code query, safe rename
    "gitnexus": {
      "type": "local",
      "cmd": [
        "gitnexus"
      ]
    },
    // MANDATORY: all agents rely on this — file I/O, shell, knowledge, sessions
    "lean-ctx": {
      "type": "local",
      "cmd": [
        "lean-ctx"
      ],
      "enabled": true,
      "env": {
        "LEAN_CTX_DATA_DIR": "$HOME/.lean-ctx"
      }
    },
    // RECOMMENDED: adds web search/scraping
    "firecrawl": {
      "type": "local",
      "cmd": [
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "YOUR_FIRECRAWL_API_KEY"
      }
    }
  }
}