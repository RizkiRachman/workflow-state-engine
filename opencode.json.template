    },
    "developer-fixer": {
      "model": "sumopod/deepseek-v4-flash",
      "temperature": 0,
      "top_p": 1,
      "steps": 40,
      "reasoningEffort": "high",
      "textVerbosity": "low",
      "permission": {
        "lean-ctx_*": "allow",
        "gitnexus_impact": "allow",
        "gitnexus_query": "allow",
        "gitnexus_context": "allow",
        "gitnexus_detect_changes": "allow",
        "morph_edit": "allow",
        "question": "allow",
        "memory_*": "deny",
        "context7_*": "deny",
        "graphify_*": "deny",
