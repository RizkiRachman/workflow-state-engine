  "mcp": {
      "context7": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@upstash/context7-mcp"
        ]
      },
      "gitnexus": {
        "type": "local",
        "command": [
          "npx",
          "gitnexus",
          "mcp"
        ]
      },
      "lean-ctx": {
        "type": "local",
        "command": [
          "/opt/homebrew/bin/lean-ctx"
        ],
        "enabled": true,
        "environment": {
          "LEAN_CTX_DATA_DIR": "/Users/rizkirachman/.lean-ctx"
        }
      },
      "firecrawl": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "firecrawl-mcp"
        ],
        "environment": {
          "FIRECRAWL_API_KEY": "{FIRECRAWL_API_KEY}"
        }
      },
      "graphify": {
        "type": "local",
        "command": [
          "graphify-mcp",
          "--graph",
          "graphify-out/graph.json"
        ],
        "enabled": true,
        "environment": {
          "OPENAI_API_KEY": "{OPENAI_API_KEY}",
          "OPENAI_BASE_URL": "https://ai.sumopod.com/v1",
          "OPENAI_MODEL": "deepseek-v4-flash"
        }
      }
    }
