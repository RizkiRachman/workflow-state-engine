{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "tech-lead",
  "model": "sumopod/deepseek-v4-flash",
  "small_model": "sumopod/deepseek-v4-flash",
  "instructions": [
    "agent.md",
    "n_m/@morphllm/opencode-morph-plugin/instructions/morph-tools.md"
  ],
  "provider": {
    "npm": "@ai-sdk/openai-compatible",
    "name": "Sumopod AI",
    "config": {
      "baseURL": "https://ai.sumopod.com/v1",
      "apiKey": "YOUR_SUMOPOD_API_KEY",
      "websearch_cited": {
        "model": "deepseek-v4-flash"
      }
    }
  },
  "models": {
    "deepseek-v4-flash": {
      "name": "DeepSeek V4 Flash",
      "config": {
        "reasoningEffort": "high",
        "textVerbosity": "low",
        "setCacheKey": true
      }
    }
  },
  "plugins": [
    "@morphllm/opencode-morph-plugin",     // OPTIONAL: enhances agent capabilities
    "@razroo/opencode-model-fallback",     // OPTIONAL: enhances agent capabilities
    "@tarquinen/opencode-dcp",             // OPTIONAL: enhances agent capabilities
    "opencode-notify",                     // OPTIONAL: enhances agent capabilities
    "opencode-vibeguard",                  // OPTIONAL: enhances agent capabilities
    "opencode-websearch-cited",            // OPTIONAL: enhances agent capabilities
    "opencode-worktree",                   // OPTIONAL: enhances agent capabilities
    "./.opencode/plugins/auto-wrap.ts",    // OPTIONAL: enhances agent capabilities
    "./.opencode/plugins/ponytail.mjs"     // OPTIONAL: enhances agent capabilities
  ],
  "compaction": {
    "reserved": 8000
  },
  "agents": {
    "tech-lead": {
      "mode": "primary",
      "model": "sumopod/deepseek-v4-flash",
      "temperature": 0,
      "top_p": 1,
      "steps": 50,
      "reasoningEffort": "high",
      "textVerbosity": "low",
      "permission": {
        "lean-ctx_*": "allow",
        "gitnexus_impact": "allow",
        "gitnexus_query": "allow",
        "gitnexus_context": "allow",
        "gitnexus_detect_changes": "allow",
        "gitnexus_rename": "allow",
        "gitnexus_route_map": "allow",
        "gitnexus_shape_check": "allow",
        "graphify_*": "allow",
        "firecrawl_*": "allow",
        "webfetch": "allow",
        "question": "allow"
      },
      "fallback_models": [
        "sumopod/deepseek-v4-flash"
      ]
    },
    "system-analyst": {
      "model": "sumopod/deepseek-v4-flash",
      "temperature": 0,
      "top_p": 1,
      "steps": 80,
      "reasoningEffort": "high",
      "textVerbosity": "low",
      "permission": {
        "task": { "*": "deny" },
        "question": "deny",
        "webfetch": "deny",
        "morph_edit": "deny",
        "gitnexus_rename": "deny",
        "write": "deny",
        "glob": "deny",
        "memory_*": "deny",
        "context7_*": "deny",
        "firecrawl_*": "deny"
      },
      "fallback_models": [
        "sumopod/deepseek-v4-flash"
      ]
    },
    "developer": {
      "model": "sumopod/deepseek-v4-flash",
      "temperature": 0,
      "top_p": 1,
      "steps": 100,
      "reasoningEffort": "high",
      "textVerbosity": "low",
      "permission": {
        "lean-ctx_*": "allow",
        "gitnexus_impact": "allow",
        "gitnexus_query": "allow",
        "gitnexus_context": "allow",
        "gitnexus_detect_changes": "allow",
        "gitnexus_rename": "allow",
        "morph_edit": "allow",
        "question": "allow",
        "memory_*": "deny",
        "morph_edit": "deny",
        "firecrawl_*": "deny",
        "context7_*": "deny"
      },
      "fallback_models": [
        "sumopod/deepseek-v4-flash"
      ]
    },
    "quality-analyst": {
      "model": "sumopod/deepseek-v4-flash",
      "temperature": 0,
      "top_p": 1,
      "steps": 80,
      "reasoningEffort": "high",
      "textVerbosity": "low",
      "permission": {
        "task": { "*": "deny" },
        "question": "deny",
        "webfetch": "deny",
        "morph_edit": "deny",
        "gitnexus_rename": "deny",
        "memory_*": "deny",
        "context7_*": "deny"
      },
      "fallback_models": [
        "sumopod/deepseek-v4-flash"
