#!/usr/bin/env bash
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
# Don't block main/master branches
if [[ "$BRANCH" == "main" || "$BRANCH" == "master" ]]; then
    exit 0
fi

# Branch naming validation: enforce feature/YYYYMMDD-* or bugfix/YYYYMMDD-*
if [[ "$BRANCH" != "main" && "$BRANCH" != "master" && "$BRANCH" != "HEAD" ]]; then
    if ! echo "$BRANCH" | grep -qE '^(feature|bugfix)/[0-9]{8}-'; then
        echo "⚠️  PRE-COMMIT: Branch name '$BRANCH' does not follow convention."
        echo "   Expected: feature/YYYYMMDD-<description> or bugfix/YYYYMMDD-<description>"
        echo "   To bypass, commit on main/master or rename with: git branch -m <new-name>"
    fi
fi

# Validate contract if it exists for this br
CONTRACT_FILE="session/$BRANCH/contract.json"
if [[ -f "$CONTRACT_FILE" ]]; then
    if [[ -f "scripts/validate-contract.sh" ]]; then
        bash scripts/validate-contract.sh --file "$CONTRACT_FILE" --score
        local EXIT_CODE=$?
        if [[ $EXIT_CODE -eq 2 ]]; then
            echo "⛔ PRE-COMMIT BLOCKED: Contract is BLOCKED (score < 50). Fix contract before committing."
            echo "   Run: scripts/self-repair.sh --dry-run to assess restoration options."
            exit 1
        fi
    fi
fi

# Run pre-flight enforcement (contract validation, blast radius, timeouts)
if [[ -f "scripts/pre-post-flight.sh" && -f "$CONTRACT_FILE" ]]; then
    bash scripts/pre-post-flight.sh pre-flight --file "$CONTRACT_FILE" --branch "$BRANCH" 2>/dev/null || true
fi

# Run ponytail pre-commit scan if available
if [[ -f "scripts/pre-commit-ponytail.sh" ]]; then
    bash scripts/pre-commit-ponytail.sh --staged 2>/dev/null || true
fi

# Sync agent states
if [[ -f "scripts/sync-agent-states.sh" ]]; then
    if ! bash scripts/sync-agent-states.sh 2>/dev/null; then
        echo "⚠️  PRE-COMMIT: Agent states drift detected. Run scripts/sync-agent-states.sh to fix."
    fi
fi

# ── Run validate-toolkit.sh for structural integrity ──────────────────────
if [[ -f "scripts/validate-toolkit.sh" ]]; then
    if ! bash scripts/validate-toolkit.sh 2>/dev/null; then
        echo "⚠️  PRE-COMMIT: validate-toolkit.sh found violations (structural integrity)"
    fi
fi

# ── Check writing order for merge conflict prevention ────────────────────
if [[ -f "scripts/check-writing-order.sh" ]]; then
    if ! bash scripts/check-writing-order.sh 2>/dev/null; then
        echo "⛔ PRE-COMMIT BLOCKED: Writing order violation detected."
        echo "   Run: scripts/check-writing-order.sh to see details."
        exit 1
    fi
fi

# ── Validate meta-contract if contract files are staged ──────────────────
if [[ -f "scripts/validate-meta-contract.sh" ]]; then
    STAGED_CONTRACT=$(git diff --cached --name-only | grep -cE '^contract/' || true)
    if [[ "$STAGED_CONTRACT" -gt 0 ]] && [[ -f "$CONTRACT_FILE" ]]; then
        if ! bash scripts/validate-meta-contract.sh --contract "$CONTRACT_FILE" 2>/dev/null; then
            echo "⚠️  PRE-COMMIT: validate-meta-contract.sh found issues"
        fi
    fi
fi

exit 0